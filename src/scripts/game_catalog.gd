static func guest_ids() -> Array[String]:
	var ids: Array[String] = []
	ids.assign(GUESTS.keys())
	return ids


static func potion_ids() -> Array[String]:
	var ids: Array[String] = []
	ids.assign(POTIONS.keys())
	return ids


static func texture_of(guest_id: String) -> Texture2D:
	return GUESTS[guest_id]["texture"]


static func bbox_of(guest_id: String) -> Rect2:
	return GUESTS[guest_id]["bbox"]


static func ingredient_name(ingredient_id: String) -> String:
	return INGREDIENTS[ingredient_id]


static func guest_name(guest_id: String) -> String:
	return GUESTS[guest_id]["name"]


static func _spoken(guest_id: String, line: String) -> String:
	return "%s\n%s" % [guest_name(guest_id), line]


static func order_line(guest_id: String, potion_id: String) -> String:
	return _spoken(guest_id, ORDERS[guest_id][potion_id])


static func success_line(guest_id: String) -> String:
	return _spoken(guest_id, SUCCESS[guest_id])


static func failure_line(guest_id: String) -> String:
	return _spoken(guest_id, FAILURE[guest_id])


static func raven_line() -> String:
	return RAVEN_WORDS[randi() % RAVEN_WORDS.size()]


static func step(potion_id: String, index: int) -> Array:
	return POTIONS[potion_id]["steps"][index]


static func step_count(potion_id: String) -> int:
	return POTIONS[potion_id]["steps"].size()


static func payout(potion_id: String, bad_number: int) -> int:
	var price: int = POTIONS[potion_id]["price"]
	return int(price * (1.0 - bad_number * 0.25))
